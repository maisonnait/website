{
  "name": "@nait/db",
  "version": "0.1.0",
  "private": true,
  "description": "Maison N'Ait data layer: Drizzle schema, migrations, seed and queries (Postgres, or PGlite locally).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "default": "./src/schema.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./phone": {
      "types": "./src/phone.ts",
      "default": "./src/phone.ts"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate && tsx scripts/embed-migrations.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:reset": "tsx scripts/reset.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "drizzle-orm": "^0.45.4",
    "postgres": "^4.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
