# Copy this file to apps/store/.env.local and apps/admin/.env.local (Next.js reads them there),
# or set the same variables in the settings of each Vercel project. Never commit real values.

# Postgres connection string, the same for both apps.
# Empty = local PGlite database stored in <repo>/.data/pglite (no server needed).
DATABASE_URL=

# Signs the sessions of the stock manager. At least 32 characters.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Owner account, created when the database has no user yet (password: 8 characters or more).
# Empty with the local PGlite database: admin@maisonnait.ma / nait-local-2026 is created.
# With a Postgres server (DATABASE_URL set) there is no default: set both.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public addresses of the two apps, without trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Optional: Vercel Blob token, for product photo uploads from the stock manager.
BLOB_READ_WRITE_TOKEN=

# Optional: not used yet.
FAL_KEY=
